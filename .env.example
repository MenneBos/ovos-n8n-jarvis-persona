# ── n8n external URL ─────────────────────────────────────────────────────────
# The URL that n8n will display in its UI when generating webhook links.
# Change this to your public domain / reverse-proxy address if applicable.
# The OVOS container always communicates with n8n via the internal Docker
# network (http://n8n:5678), so this value only affects the n8n UI.
N8N_EXTERNAL_URL=http://localhost:5678
